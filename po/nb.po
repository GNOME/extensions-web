msgid "The `version-name` field in `metadata.json` must be a string"
msgstr "Feltet `version-name` i `metadata.json` må være en streng"

#: sweettooth/extensions/serializers.py:94 extensions-web-domain-django:1
msgid "You must agree with the extensions.gnome.org terms of service"
msgstr "Du må godta brukervilkårene for extensions.gnome.org"

